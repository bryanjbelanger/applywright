{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "core_skills", "experience"],
  "properties": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_ids"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "core_skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "evidence_ids"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "experience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["employer", "title", "start_year", "end_year", "overview", "engagements"],
        "properties": {
          "employer": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "start_year": { "type": "string", "pattern": "^[0-9]{4}$" },
          "end_year": { "type": "string", "pattern": "^([0-9]{4}|Present)$" },
          "overview": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "evidence_ids"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          "engagements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["client"],
              "anyOf": [
                { "required": ["overview"] },
                { "required": ["achievements"] }
              ],
              "properties": {
                "client": { "type": "string", "minLength": 1 },
                "overview": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["text", "evidence_ids"],
                  "properties": {
                    "text": { "type": "string", "minLength": 1 },
                    "evidence_ids": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "achievements": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["text", "evidence_ids"],
                    "properties": {
                      "text": { "type": "string", "minLength": 1 },
                      "evidence_ids": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
