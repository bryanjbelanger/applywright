<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <link rel="stylesheet" href="application.css">
</head>
<body>
    <h1>{{ candidate.name }}</h1>
    <p>{{ candidate.location }} | {{ candidate.phone }} | <span style="white-space: nowrap">{{ candidate.email }}</span>{% if candidate.get('linkedin') %} | <span style="white-space: nowrap">{{ candidate.linkedin }}</span>{% endif %}{% if candidate.get('github') %} | <span style="white-space: nowrap">{{ candidate.github }}</span>{% endif %}</p>

    <h2 id="summary">Professional Summary</h2>
    <p>{{ resume.summary.text }}</p>

    <h2 id="skills">Core Technical Skills</h2>
    <ul>
    {% for skill in resume.core_skills %}
        <li>{{ skill.text }}</li>
    {% endfor %}
    </ul>

    <h2 id="experience">Professional Experience</h2>
    {% for exp in resume.experience %}
    <h3>{{ exp.title }} | <span class="employer-name">{{ exp.employer }}</span> | {{ exp.start_year }}–{{ exp.end_year }}</h3>
    {% if 'overview' in exp and exp.overview %}
    <p>{{ exp.overview.text }}</p>
    {% endif %}
    {% for engagement in exp.engagements %}
    <section class="engagement">
        <p class="engagement-overview">
            <strong class="client-name">{{ engagement.client }}:</strong> {% if 'overview' in engagement and engagement.overview %}{{ engagement.overview.text }}{% endif %}
        </p>
        {% if 'achievements' in engagement and engagement.achievements %}
        <ul class="achievement-list">
            {% for ach in engagement.achievements %}
            <li class="achievement">{{ ach.text }}</li>
            {% endfor %}
        </ul>
        {% endif %}
    </section>
    {% endfor %}
    {% endfor %}

    <h2 id="education">Education</h2>
    {% for edu in candidate.education %}
    <p><strong>{{ edu.degree }}</strong> {{ edu.institution }}</p>
    {% endfor %}

    <h2 id="certifications">Certifications</h2>
    {% if candidate.certifications %}
    <p>{{ candidate.certifications | join(' | ') }}</p>
    {% endif %}
</body>
</html>
